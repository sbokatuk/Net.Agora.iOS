<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which package to exercise (Video, Voice, Signaling, Chat, Whiteboard or Fastboard) and which
      of its target frameworks. Both go through properties of our own: overriding TargetFramework
      directly on the command line breaks restore, and one app holds exactly one product. That last
      part is a hard constraint twice over: the RTC pair both ship a framework named AgoraRtcKit,
      and Whiteboard and Fastboard both carry netless's static library — Fastboard's contains
      Whiteboard's objects outright, as nm on AgoraFastboardBridge.xcframework shows, and the two
      declare the same Whiteboard_Whiteboard.bundle. Referencing those two together is an
      unsupported combination, not a size optimisation.
    -->
    <AgoraDevicePackage Condition=" '$(AgoraDevicePackage)' == '' ">Video</AgoraDevicePackage>
    <AgoraDeviceTargetFramework Condition=" '$(AgoraDeviceTargetFramework)' == '' ">net9.0-ios18.0</AgoraDeviceTargetFramework>
    <TargetFramework>$(AgoraDeviceTargetFramework)</TargetFramework>
    <!--
      The voice pod ships the same AgoraRtcKit framework name with the video pipeline stripped
      from the binary, and the Voice binding deliberately does not bind the video entry points.
      The smoke tests compile per flavour — different using, different framework list, different
      checks — rather than probing at runtime, so every remaining assertion stays strict.
      Signaling is a different product entirely (AgoraRtmKit), with its own flavour of the suite —
      the one that exercises an [Async] method end-to-end.

      Chat is a fourth product on a fourth framework pair (AgoraChat + aosl) and gets the same
      treatment. Whiteboard and Fastboard are the odd ones out: their native payload is a *static*
      library, so there is no framework for the dyld image check to find and their flavours prove
      class registration and resource-bundle delivery instead — see SmokeTests.cs.

      Constant names match the façade repository's tests/Net.Agora.DeviceTests, so a check moved
      between the two suites does not have to be re-guarded.
    -->
    <DefineConstants Condition=" '$(AgoraDevicePackage)' == 'Voice' ">$(DefineConstants);AGORA_VOICE</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDevicePackage)' == 'Signaling' ">$(DefineConstants);AGORA_SIGNALING</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDevicePackage)' == 'Chat' ">$(DefineConstants);AGORA_CHAT</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDevicePackage)' == 'Whiteboard' ">$(DefineConstants);AGORA_WHITEBOARD</DefineConstants>
    <DefineConstants Condition=" '$(AgoraDevicePackage)' == 'Fastboard' ">$(DefineConstants);AGORA_FASTBOARD</DefineConstants>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.agora.ios.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Matches AgoraRtcKit's own minimum — see src/Agora.Binding.props. -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>

    <!--
      The checks report through stdout, which the runner script streams back with `simctl launch`
      in console-pty mode. Quietening the Mono logger keeps that stream to the test output rather
      than runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>

    <!--
      The interpreter, explicitly. The .NET 9 iOS SDK JITs a Debug simulator build; the .NET 8 one
      puts the runtime in aot-only mode for the same command line and then dies on the first
      assembly it has no AOT image for. Setting it for both bands rather than only net8 keeps the
      matrix legs comparable — a check that passes under the interpreter on one target framework
      and under the JIT on another is not testing quite the same thing. See the Debug comment in
      .github/scripts/run-simulator-tests.sh for why nothing AOT-shaped is lost.
    -->
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <!--
    The e2e deliberately consumes the packed NuGet from ./artifacts rather than a ProjectReference,
    so it exercises the artifact that actually gets published — the merged three-target-framework
    package out of build/merge-packages.py, native payload and all, which a ProjectReference would
    prove nothing about. See NuGet.config for the local feed.
  -->
  <PropertyGroup>
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' And '$(AgoraDevicePackage)' == 'Voice' ">$(AgoraVoiceIosVersion).$(AgoraVoiceBindingRevision)</AgoraDevicePackageVersion>
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' And '$(AgoraDevicePackage)' == 'Signaling' ">$(AgoraSignalingIosVersion).$(AgoraSignalingBindingRevision)</AgoraDevicePackageVersion>
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' And '$(AgoraDevicePackage)' == 'Chat' ">$(AgoraChatIosVersion).$(AgoraChatBindingRevision)</AgoraDevicePackageVersion>
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' And '$(AgoraDevicePackage)' == 'Whiteboard' ">$(AgoraWhiteboardIosVersion).$(AgoraWhiteboardBindingRevision)</AgoraDevicePackageVersion>
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' And '$(AgoraDevicePackage)' == 'Fastboard' ">$(AgoraFastboardIosVersion).$(AgoraFastboardBindingRevision)</AgoraDevicePackageVersion>
    <!-- Video's line, which is what $(VersionPrefix) defaults to — see Directory.Build.props. -->
    <AgoraDevicePackageVersion Condition=" '$(AgoraDevicePackageVersion)' == '' ">$(VersionPrefix)</AgoraDevicePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build missing from
      artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.$(AgoraDevicePackage).iOS" Version="[$(AgoraDevicePackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both None (the item type) and LogicalName="Info.plist" (the metadata) are required: this is a
      plain iOS SDK project, not MAUI, and _DetectAppManifest locates a manifest by LogicalName
      rather than by path — see the equivalent comment in the façade repository's
      tests/Net.Agora.DeviceTests project, where a plain unreferenced Info.plist built clean but
      none of its keys made it into the app bundle.
    -->
    <None Include="Info.plist" LogicalName="Info.plist" />
  </ItemGroup>

</Project>
