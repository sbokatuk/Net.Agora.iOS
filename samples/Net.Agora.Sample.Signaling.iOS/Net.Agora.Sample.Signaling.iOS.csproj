<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MAUI sample (iOS only) that drives Agora Signaling directly against the raw binding —
    AgoraRtmClientKit and its Objective-C completion blocks, no cross-platform wrapper. The
    wrapped, cross-platform version (awaitable calls and .NET events) is
    Net.Agora/samples/Net.Agora.Sample.Signaling: https://github.com/sbokatuk/Net.Agora. What this
    one shows is the block-based surface the façade hides.

    Consumes the packed Net.Agora.Signaling.iOS package from artifacts/ (see NuGet.config), so it
    exercises the package exactly as a consumer would.
  -->
  <PropertyGroup>
    <!--
      Both target frameworks the .NET 9 SDK band can build, so the sample proves the package
      resolves on each. net10.0-ios26.0 is deliberately left out: it needs the .NET 10 band, which
      would mean a second SDK and MAUI workload install to compile a sample that exercises exactly
      the same API. The device tests already run against net10.

      The platform version is pinned to match the package's lib/ folders. A bare net9.0-ios
      resolves to the iOS 26 reference pack, which refuses to build unless Xcode is exactly 26.0 —
      an unnecessary constraint for a sample. A consuming app targeting a later platform version
      still resolves these assets, since 18.0 is compatible with them.
    -->
    <TargetFrameworks>net8.0-ios18.0;net9.0-ios18.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Net.Agora.Sample.Signaling.iOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationTitle>Net.Agora.Signaling.iOS Sample</ApplicationTitle>
    <ApplicationId>com.sbokatuk.agora.sample.signaling.ios</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Matches AgoraRtmKit's own minimum — see src/Agora.Binding.props. -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

    <!--
      Supplies ILoggingBuilder.AddDebug, which MauiProgram calls inside #if DEBUG. Referenced
      unconditionally rather than only for Debug: a configuration-dependent PackageReference makes
      restore differ between configurations, and this is how the MAUI template ships it.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Defaults to the version in Directory.Build.props so a plain build after "build/BuildNugets.sh"
      works; override with -p:AgoraVideoPackageVersion=... to test a specific build.
    -->
    <AgoraSignalingPackageVersion Condition=" '$(AgoraSignalingPackageVersion)' == '' ">$(AgoraSignalingIosVersion).$(AgoraSignalingBindingRevision)</AgoraSignalingPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Exact version, in brackets — a bare version is a *minimum* to NuGet, so a build missing from
      artifacts/ would silently resolve from nuget.org instead of failing the restore.
    -->
    <PackageReference Include="Net.Agora.Signaling.iOS" Version="[$(AgoraSignalingPackageVersion)]" />
  </ItemGroup>

</Project>
