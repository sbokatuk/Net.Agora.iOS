<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Net.Agora.Sample.Fastboard.iOS"
             x:Class="Net.Agora.Sample.Fastboard.iOS.MainPage"
             Title="Net.Agora Fastboard (raw)">

    <Grid Padding="12" RowSpacing="8" RowDefinitions="Auto,Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="2*,*" ColumnSpacing="8">
            <Entry x:Name="AppIdentifierEntry" Placeholder="Whiteboard App Identifier (org/app)" />
            <Entry x:Name="RegionEntry" Grid.Column="1" Placeholder="Region, e.g. us-sv" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Entry x:Name="RoomUuidEntry" Placeholder="Room UUID" />
            <Entry x:Name="RoomTokenEntry" Grid.Column="1" Placeholder="Room token" />
        </Grid>

        <!--
            The board *and its toolbar* — Fastboard brings tools, colours, undo/redo and page
            navigation with it, drawn straight onto the UIView the shim hands back.
        -->
        <local:FastboardHostView x:Name="Board" Grid.Row="2" />

        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <Button x:Name="JoinButton" Text="Join" Clicked="OnJoinClicked" />
            <Button x:Name="LeaveButton" Text="Leave" Clicked="OnLeaveClicked" IsEnabled="False" />
            <Button x:Name="ReadOnlyButton" Text="Read-only" Clicked="OnReadOnlyClicked" IsEnabled="False" />
            <Button x:Name="RedPencilButton" Text="Red pencil" Clicked="OnRedPencilClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <!--
            No LineBreakMode: a truncating label isn't re-measured when its text changes, so this
            one, which starts empty, would keep a height of zero and never appear.
        -->
        <Label x:Name="StatusLabel" Grid.Row="4" FontSize="12" />

    </Grid>

</ContentPage>
